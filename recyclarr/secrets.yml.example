# Copy this file to secrets.yml (gitignored, never commit real values) and
# fill in the api keys. Recyclarr's config format doesn't support reading
# process environment variables, so these can't just point at ../.env the
# way the rest of this stack does — same SONARR_API_KEY/RADARR_API_KEY
# values already sitting in ../.env need to be copied here too.
#
# base_url is the internal docker-compose service address — same one
# annas-archive itself talks to (see Sonarr__BaseUrl/Radarr__BaseUrl in
# ../docker-compose.yml) — leave these as-is unless you renamed the services.
radarr_url: http://radarr:7878
radarr_apikey:
sonarr_url: http://sonarr:8989
sonarr_apikey:
