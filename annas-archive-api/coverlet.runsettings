<?xml version="1.0" encoding="utf-8" ?>
<!--
  Backend coverage settings. Nothing runs this automatically: there is no CI here
  and the repo commits no shell scripts, so it is invoked by hand. The exact
  commands are in README.md under "Test coverage" (they cannot live in an XML
  comment, which may not contain a double hyphen, and every dotnet flag has one).
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>
            <!-- Exclude auto-generated files -->
            [*.Tests?]*
            [*]*.Program

            <!-- Exclude specific types that are hard to test -->
            [AnnasArchive.Api]Program

            <!-- Exclude by attribute -->
            [*]*Attribute
            [*]*Attributes

            <!-- Exclude by file path pattern (auto-generated) -->
          </Exclude>

          <ExcludeByFile>
            <!-- Exclude all auto-generated files -->
            **/*.g.cs
            **/*.designer.cs
            **/obj/**
            **/bin/**

            <!-- Exclude Migrations if you have them -->
            **/Migrations/**
          </ExcludeByFile>

          <Include>
            <!--
              Both shipped assemblies. This said [AnnasArchive.Core]* alone, which
              sounds like "our business logic" but is not: Core is ~4.8k lines and
              the API project is ~46k. Measuring only Core reports a coverage number
              for under a tenth of the code and silently omits every service,
              endpoint and helper — the parts most worth knowing about.
            -->
            [AnnasArchive.Api]*
            [AnnasArchive.Core]*
          </Include>

          <IncludeDirectory>
            ../src/**
          </IncludeDirectory>

        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
